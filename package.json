{
  "name": "llm-party",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --ignore ./data server/local.ts",
    "build": "vite build",
